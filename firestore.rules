rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMonitoring() {
      return isAuthenticated() && (
        request.auth.token.email == 'ciseb.adm@escola.seduc.pa.gov.br' ||
        (request.auth.token.role != null && request.auth.token.role == 'monitoramento')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ==========================================
    // 1. ESCOLAS CANÔNICAS (/escolas/{escolaId})
    // ==========================================
    function isValidEscola(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.nome is string && data.nome.size() >= 3 && data.nome.size() <= 200
        && (!('dre' in data) || (data.dre is string && data.dre.size() <= 120))
        && (!('status' in data) || (data.status in ['ativo', 'inativo']))
        && (!('municipio' in data) || (data.municipio is string && data.municipio.size() <= 120))
        && (!('codigo' in data) || (data.codigo is string && data.codigo.size() <= 128));
    }

    match /escolas/{escolaId} {
      allow read: if true;
      allow create, update: if isValidId(escolaId) && isValidEscola(request.resource.data);
      allow delete: if isValidId(escolaId) && isMonitoring();
    }

    // ==========================================
    // 2. CONTAS E USUÁRIOS (/accounts/{accountId})
    // Zero-Trust: O professor NÃO altera sua própria escola.
    // Proibição total de armazenamento de senhas no Firestore.
    // ==========================================
    function isValidAccountData(data) {
      return !('senha' in data) && !('password' in data)
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.nome is string && data.nome.size() >= 2 && data.nome.size() <= 150
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && (
          data.email.matches('.*@escola\\.seduc\\.pa\\.gov\\.br$') ||
          data.email.matches('.*@seduc\\.pa\\.gov\\.br$')
        )
        && (!('escolaId' in data) || (data.escolaId is string && data.escolaId.size() <= 128))
        && (!('escolaNome' in data) || (data.escolaNome is string && data.escolaNome.size() <= 200))
        && (!('unidadeCiseb' in data) || (data.unidadeCiseb is string && data.unidadeCiseb.size() <= 200))
        && (!('dre' in data) || (data.dre is string && data.dre.size() <= 120))
        && (!('role' in data) || (data.role in ['formador', 'coordenador', 'monitoramento']))
        && (!('status' in data) || (data.status in ['ativo', 'inativo']));
    }

    match /accounts/{accountId} {
      allow read: if true;
      allow create, update: if isValidId(accountId) && isValidAccountData(request.resource.data);
      allow delete: if accountId == 'admin_coordenacao' || (isValidId(accountId) && isMonitoring());
    }

    // ==========================================
    // 3. PLANOS DE AULA E ROBÓTICA (/plans/{planId})
    // ==========================================
    function isValidPlan(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.unidadeCiseb is string && data.unidadeCiseb.size() > 0 && data.unidadeCiseb.size() <= 200
        && data.professorFormador is string && data.professorFormador.size() > 0 && data.professorFormador.size() <= 200;
    }

    match /plans/{planId} {
      allow read: if true;
      allow create: if isValidId(planId) && isAuthenticated() && isValidPlan(request.resource.data);
      allow update: if isValidId(planId) && isAuthenticated() && isValidPlan(request.resource.data);
      allow delete: if isValidId(planId) && isAuthenticated();
    }

    // ==========================================
    // 4. PERGUNTAS E FAQ (/perguntas/{perguntaId})
    // ==========================================
    function isValidPergunta(data) {
      return data.pergunta is string && data.pergunta.size() >= 3 && data.pergunta.size() <= 5000
        && (!('usuarioEmail' in data) || (data.usuarioEmail is string && data.usuarioEmail.size() <= 150));
    }

    match /perguntas/{perguntaId} {
      allow read: if true;
      allow create: if isValidId(perguntaId) && isAuthenticated() && isValidPergunta(request.resource.data);
      allow update: if isValidId(perguntaId) && isAuthenticated() && isValidPergunta(request.resource.data);
      allow delete: if isValidId(perguntaId) && (isAuthenticated() || isMonitoring());
    }

    // Fallback de bloqueio padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
