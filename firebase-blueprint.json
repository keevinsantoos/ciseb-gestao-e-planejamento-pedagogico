{
  "entities": {
    "Plan": {
      "title": "Plan",
      "description": "Plano de Atendimento e Suporte de Prototipagem do CISEB",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "modalidade": { "type": "string" },
        "unidadeCiseb": { "type": "string" },
        "professorFormador": { "type": "string" },
        "temaImersao": { "type": "string" },
        "tituloSuporte": { "type": "string" },
        "cargaHorariaAulas": { "type": "string" },
        "turmaParticipante": { "type": "string" },
        "bnccCompetencias": { "type": "array", "items": { "type": "string" } },
        "bnccHabilidadesEixo": { "type": "array", "items": { "type": "string" } },
        "odsAplicada": { "type": "array", "items": { "type": "string" } },
        "trilhaImersao": { "type": "string" },
        "fase1Empatia": { "type": "string" },
        "fase2TempestadeIdeias": { "type": "string" },
        "fase3PrototipagemSolucao": { "type": "string" },
        "tipoPrototipo": { "type": "string" },
        "recursosDidaticosTecnologicos": { "type": "string" },
        "roteiroPedagógico": { "type": "string" },
        "expectativaAprendizagem": { "type": "string" },
        "publicoAlvoDetalhamento": { "type": "string" },
        "observacoes": { "type": "string" },
        "createdBy": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorNome": { "type": "string" }
      },
      "required": ["id", "unidadeCiseb", "professorFormador", "updatedAt"]
    },
    "Account": {
      "title": "Account",
      "description": "Conta de Professor Formador ou Equipe de Monitoramento CISEB",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "nome": { "type": "string" },
        "escolaId": { "type": "string" },
        "escolaNome": { "type": "string" },
        "unidadeCiseb": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "cadastradoPor": { "type": "string" },
        "dataCadastro": { "type": "string" },
        "criadoPor": { "type": "string" },
        "criadoEm": { "type": "string" },
        "atualizadoPor": { "type": "string" },
        "atualizadoEm": { "type": "string" }
      },
      "required": ["id", "nome", "email", "role", "escolaId"]
    },
    "Escola": {
      "title": "Escola",
      "description": "Unidade Escolar Oficial Integrada ao CISEB / SEDUC-PA",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "codigo": { "type": "string" },
        "nome": { "type": "string" },
        "municipio": { "type": "string" },
        "status": { "type": "string" },
        "criadoPor": { "type": "string" },
        "criadoEm": { "type": "string" },
        "atualizadoPor": { "type": "string" },
        "atualizadoEm": { "type": "string" }
      },
      "required": ["id", "nome", "municipio", "status"]
    },
    "Pergunta": {
      "title": "Pergunta",
      "description": "Dúvida ou solicitação de suporte enviada por educadores do CISEB",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pergunta": { "type": "string" },
        "usuarioNome": { "type": "string" },
        "usuarioEmail": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["pergunta", "usuarioEmail", "createdAt"]
    }
  },
  "firestore": {
    "/escolas/{escolaId}": {
      "schema": "Escola",
      "description": "Coleção canônica de Unidades Escolares Oficiais CISEB / SEDUC-PA"
    },
    "/plans/{planId}": {
      "schema": "Plan",
      "description": "Coleção de planos de atendimento pedagógico do CISEB"
    },
    "/accounts/{accountId}": {
      "schema": "Account",
      "description": "Coleção de contas e perfis públicos institucionais do CISEB (sem senhas)"
    },
    "/perguntas/{perguntaId}": {
      "schema": "Pergunta",
      "description": "Coleção de dúvidas e mensagens de suporte enviadas pelos educadores"
    }
  }
}
