# GEMINI_API_KEY / GEMINI-KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI-KEY="MY_GEMINI_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT_KEY: (Optional/Recommended for Server-Side Admin Actions)
# JSON string of Firebase Admin Service Account credentials.
# Used for server-side user provisioning and custom claims management.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# VITE_MAG_EXTERNAL_URL: (Optional) External URL for MAG Pedagogical Mentor
VITE_MAG_EXTERNAL_URL="https://chatgpt.com/g/g-67cd98a0c4f8819198642a8b3d6f1df8-mag-mentora-pedagogica-ciseb"

